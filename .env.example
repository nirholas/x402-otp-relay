# ── Where the money goes ─────────────────────────────────────────────────────
# Both rails ship pre-filled with the x402 Suite's public receive addresses, so
# the service runs out of the box. Change them to YOUR addresses to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ─────────────────────────────────────────────────────────────────
# EVM rail: base-sepolia (default, testnet) or base (mainnet).
NETWORK=base-sepolia
# Solana rail: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# ── Facilitators (verify + settle) ───────────────────────────────────────────
#   x402.org           → base-sepolia, solana-devnet   (free, testnet)
#   facilitator.payai  → base, base-sepolia, solana    (free, no API key)
FACILITATOR_URL=https://x402.org/facilitator
SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# ── The relay ────────────────────────────────────────────────────────────────
# The domain mailbox addresses are issued under. In production this must be a
# domain whose MX record points at this server — that is what makes real
# verification email arrive.
#
#   relay.example.com.  IN  MX  10  smtp.example.com.
#
# `relay.localhost` is fine for local development: nothing external resolves it,
# but you can still deliver to the SMTP port directly (see examples/).
RELAY_DOMAIN=relay.localhost

# Inbound SMTP port. Real mail needs 25, which requires root or
# CAP_NET_BIND_SERVICE; 2525 is the conventional unprivileged alternative.
SMTP_PORT=2525
# Bind address for the SMTP listener. Leave unset to listen on all interfaces.
# SMTP_HOST=0.0.0.0

# How long a mailbox lives, in milliseconds. Default 15 minutes — longer than
# any OTP's own validity, and short enough that this isn't a standing pile of
# other people's verification codes. Hard cap 24h.
MAILBOX_TTL_MS=900000

# Where live mailboxes and their mail are persisted.
MAILBOX_FILE=data/mailboxes.json

# ── Signing ──────────────────────────────────────────────────────────────────
# Secret for the HMAC-SHA256 signatures on mailbox and code records. A dev
# default is used when unset — ALWAYS set your own in production.
# SIGNING_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4035
# Public origin used in the 402 `resource` field when behind a proxy.
# PUBLIC_BASE_URL=https://otp.example.com

# ── Client example (examples/agent-client.ts) ────────────────────────────────
# Funded base-sepolia wallet the example agent pays with.
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4035
